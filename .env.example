# TEMPLATE ONLY — safe to commit. No real values here.
# Copy this file to ".env.local" and fill in real values.
# .env.local is gitignored and must NEVER be committed or shared.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
AI_DAILY_CEILING=150
PARENT_PIN=
# Authenticates Vercel Cron -> /api/cron/behavior-signals (F4 nightly job).
# Set the same value in Vercel project env vars; Vercel then auto-attaches
# it as "Authorization: Bearer <value>" to its own cron invocations.
CRON_SECRET=
